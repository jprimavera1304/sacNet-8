      "EsCaja": 0,
      "EsServicio": 0,
      "Identico": 0
    }
  },
  "nuevo": {
    "method": "GET",
    "path": "/api/catalogos/unidades-medida"
  },
  "camino_legacy": "result.catUnidadesMedida",
  "camino_nuevo": "data",
